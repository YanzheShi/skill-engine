# config.yml 示例（无密钥，可入库）。复制为 config.yml 并填值：
#   cp config.yml.example config.yml
#
# 密钥建议用 ${ENV} 引用，保持本文件可安全提交；真实 key 放在环境或 .env。
# 也可直接写明文（config.yml 已被 .gitignore 忽略）。

models:
  # 内置主/备模型（get_llm(purpose) 与 MOA 的 default / secondary 别名）
  - name: default
    model: gpt-4o
    base_url: https://api.openai.com/v1
    api_key: ${OPENAI_API_KEY}
    provider: openai
  - name: secondary
    model: gpt-4o-mini
    base_url: https://api.openai.com/v1
    api_key: ${OPENAI_API_KEY}
    provider: openai

  # MOA 多模型协作：自定义 profile（按需增删）
  - name: deepseek
    model: deepseek-chat
    base_url: https://api.deepseek.com
    api_key: ${DEEPSEEK_API_KEY}
    provider: openai
  - name: claude-vl
    model: claude-3-5-sonnet-20241022
    base_url: https://api.anthropic.com/v1
    api_key: ${ANTHROPIC_API_KEY}
    provider: anthropic

settings:
  security_mode: permissive      # strict（默认，拦截危险命令）/ permissive（弹窗）/ off
  auto_approve: all              # skill_name:binary 或 all；无头/agent-eval 驱动用 all
  allowlist: ""                  # 逗号分隔的 skill 白名单，空为全部允许
  context_budget: 12000          # 上下文压缩预算（token）
  mcp_config: ./mcp.json         # MCP 服务器配置文件路径（mcp.json 保持独立）
  mcp_hub_token: ${MCP_HUB_TOKEN}  # 共享 mcp-hub 网关的本应用 bearer token（web_search 等经它走）
  tavily_api_key: ${TAVILY_API_KEY}  # 仅当有 skill 直连 Tavily 时需要；web_search 已改经 mcp-hub
  vault_path: ""
  ollama_host: ""
  # R2 图片托管：view_image 注入图片时上传到 R2 换公网 URL。
  # 未配置时回退 base64 内联，不影响其它模型。
  r2_token: ${CF_R2_TOKEN}
  r2_account_id: ${CF_R2_ACCOUNT_ID}
  r2_bucket: ${CF_R2_BUCKET}
  r2_public_base: ${CF_R2_PUBLIC_BASE}
  # 调试轨迹落盘（JSONL）：记录上下文/状态栏/交互流程。
  # debug_log 非空即开启并作为日志路径（CI 也可用环境变量 SKILL_ENGINE_DEBUG_LOG 覆盖，注入优先）；
  # debug: true 仅开开关、用默认路径 <working_root>/.<时间戳>.skill-engine-debug.log。
  debug_log: ""
  debug: false

  # Windows srt 沙箱（docs/sandbox-integration-design.md §4.7）。
  # 路由：只读白名单裸跑；删除类/联网/宿主工具审批后裸跑；其余一切进沙箱。
  # 环境变量整体开关：SKILLS_ENGINE_SANDBOX=on|off（优先于本段）；
  # SKILL_ENGINE_SRT_WIN 可直接指定 srt-win.exe 路径（默认搜 npx 缓存）。
  sandbox:
    enabled: true            # false = 全部命令裸跑，退回沙箱引入前的行为；
                             #   注意：关掉的只是「进不进隔离」，ASK 审批链路
                             #   不受影响——删除类/联网/宿主工具命令照样拦。
                             #   等价的运行时开关：SKILLS_ENGINE_SANDBOX=off
    on_unavailable: warn     # warn（默认，告警后裸跑）/ block（拒绝执行）
    # 额外要 stamp denyRead 的机密文件（相对工作目录或绝对路径）。
    # config.yml / config.yaml / mcp.json / .env 已默认保护，无需重复列。
    # 注意：stamp 成本随该文件父目录子树大小上升（项目根 17320 文件约 4s/文件），
    # 同一父目录的多个文件会在一次调用里合并，所以默认只在首次进沙箱时触发。
    deny_read: []
    # 需要沙箱只读授权的宿主目录（如依赖缓存 C:\Users\<user>\AppData\Local\uv）。
    # 默认空：本机工作目录对沙箱用户已可写，无需 grant。
    grant_read: []
    srt_bin: ""              # 显式指定 srt-win.exe；空 = 自动搜索
    env_passthrough: []      # 允透传进沙箱的疑似密钥变量名（默认全部拦下）
