# ── Skills Engine 环境变量配置示例 ──
# 复制此文件为 .env 并填入你的配置信息
# cp .env.example .env

# ============================================
# LLM 配置（至少配一个）
# ============================================
# 主模型——任何 OpenAI 兼容 API 均可（SenseNova、DeepSeek、OpenAI、vLLM 等）
LLM_MODEL=gpt-4o
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=sk-your-api-key

# 备用模型（可选，当前没有主动使用，留作扩展）
# LLM_MODEL_ALT=deepseek-chat
# LLM_BASE_URL_ALT=https://api.deepseek.com
# LLM_API_KEY_ALT=sk-your-deepseek-key

# ============================================
# 安全模式（可选）
# ============================================
# strict  — 默认，危险命令直接拦截
# permissive — 危险命令弹窗确认
# off     — 所有命令放行
# SKILLS_ENGINE_SECURITY_MODE=permissive

# ============================================
# 自动审批（可选，跳过弹窗）
# ============================================
# 格式: skill_name:binary  或  all
# 例如 "cleanup-temp:rm" 表示 cleanup-temp skill 的 rm 命令自动放行
# SKILLS_ENGINE_AUTO_APPROVE=all

# ============================================
# MCP 服务器配置（可选）
# ============================================
# 指向 mcp.json 配置文件，用于连接外部 MCP 服务器
# SKILL_ENGINE_MCP_CONFIG=./mcp.json

# ============================================
# Tavily 搜索 API（可选，用于 web_search 工具）
# ============================================
# 免费注册：https://app.tavily.com
# TAVILY_API_KEY=tvly-xxx

# ============================================
# 其他可选配置
# ============================================
# Vault 路径（部分 skill 可能用到）
# VAULT_PATH=/path/to/your/vault

# Ollama 本地模型（可选，如果你用 Ollama 作为 LLM 后端）
# OLLAMA_HOST=http://localhost:11434