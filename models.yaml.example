# models.yaml —— MOA 多模型协作的模型 profile 声明（结构化配置）
#
# 用法：
#   1. 复制本文件为 models.yaml：  cp models.yaml.example models.yaml
#   2. 填入你的模型与密钥（models.yaml 已被 .gitignore 忽略，不会入库）
#   3. 运行 `skill-engine moa --list-models` 确认已加载
#
# api_key 两种写法（可混用）：
#   - 明文（你当前选择的方案）：  api_key: sk-xxxx
#   - 引用环境变量（YAML 可入库）：api_key: ${DEEPSEEK_API_KEY}
#     此时真实 key 写在 .env 里：DEEPSEEK_API_KEY=sk-xxxx
#
# provider 对应 langchain init_chat_model 的 model_provider：
#   OpenAI 兼容网关(DeepSeek/通义/智谱/本地 vLLM/SenseNova) 用 openai（默认，可省略）
#   Anthropic -> anthropic    Gemini -> google    Azure -> azure_openai
#   Ollama -> ollama          Bedrock -> bedrock

models:
  # —— 内置 default / secondary 已自动来自 .env，这里无需重复 ——

  # 示例 1：DeepSeek（OpenAI 兼容，明文写法）
  - name: deepseek
    model: deepseek-chat
    base_url: https://api.deepseek.com
    api_key: sk-xxxxxxxxxxxxxxxxxxxxxxxx
    provider: openai

  # 示例 2：Claude 多模态（前端视觉审查用，引用环境变量写法）
  - name: claude-vl
    model: claude-3-5-sonnet-20241022
    base_url: https://api.anthropic.com/v1
    api_key: ${ANTHROPIC_API_KEY}
    provider: anthropic

  # 示例 3：通义千问（OpenAI 兼容网关）
  - name: qwen
    model: qwen-max
    base_url: https://dashscope.aliyuncs.com/compatible-mode/v1
    api_key: sk-xxxxxxxxxxxxxxxxxxxxxxxx
    provider: openai
