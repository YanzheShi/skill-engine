# Skills Engine 环境变量配置模板
# 复制此文件为 .env 并填入你的 API Key

# === LLM 配置 ===
# 主模型（默认配置名 agnes，被各模块自动读取）
AGNES_MODEL=your-model-name
AGNES_BASE_URL=https://api.example.com/v1
AGNES_API_KEY=sk-your-api-key

# Sensenova（可选）
SENSENOVA_API_KEY=sk-your-sensenova-key
SENSENOVA_BASE_URL=https://token.sensenova.cn/v1
SENSENOVA_MODEL=your-model-name
SENSENOVA_MODEL1=your-model-name

# OpenAI 兼容（可选）
OPENAI_API_KEY=sk-your-openai-key

# DeepSeek（可选）
DEEPSEEK_API_KEY=sk-your-deepseek-key
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com

# 通义千问（可选）
DASHSCOPE_API_KEY=sk-your-dashscope-key

# === 其他配置 ===
VAULT_PATH=D:\Note\test
OLLAMA_HOST=http://localhost:11434

# === Judge0 判题沙箱（可选） ===
JUDGE0_REDIS_PASSWORD=change-me
JUDGE0_POSTGRES_PASSWORD=change-me
JUDGE0_MEM_LIMIT=512000000
JUDGE0_CPU_TIME_LIMIT=5
JUDGE_BACKEND=self
SECRET_KEY_BASE=change-me
ADMIN_PASSWORD=change-me