# --- Python ---
__pycache__/
*.py[cod]
*.pyo
*.egg-info/
dist/
build/
*.egg
*.whl
*.so
*.pyd

# --- Virtual environments ---
.venv/
venv/
env/
.venv.bak/

# --- IDE ---
.claude/
.idea/
.vscode/
*.swp
*.swo
*~

# --- Testing ---
.pytest_cache/
.coverage
coverage/
htmlcov/
*.coverage.*
.tox/

# --- Skill Engine derived cache (LLM-extracted meta, rebuildable; NOT skill assets) ---
.skill-meta.yaml
.skill-engine/cache/

# --- Linting ---
.ruff_cache/
.mypy_cache/
.dmypy.json
dmypy.json

# --- OS ---
.DS_Store
Thumbs.db
*.log

# --- Project specific ---
# uv lock file is auto-generated
uv.lock

# Generated / temp directories
.ai/
analysis_output/
output/
${ANALYSIS_OUTPUT_DIR}/
fix_indent.py
.workbuddy/

# --- Runtime artifacts (never commit) ---
# 引擎运行时产物统一收口到工作目录的 .skill-engine/ 子目录（见 docs/runtime-artifacts-runtime-dir-redirect.md），
# 覆盖：文件快照 snapshots/、交互 session/、pastes/、截图 screenshots/、debug 日志、MOA 检查点等。
.skill-engine/
junit.xml
junit_full.xml
demo/
# 展示用 demo 资源（截图/案例）需随仓库发布，重新纳入版本控制
!demo/
!demo/**
logs_*.log
_approval_debug.log
bt.log
p6.log
pt_result.log

# Isolated venv used by some scripts (already self-ignored, belt-and-suspenders)
active/

# .env files may contain API keys
.env
.env.*
!.env.example

# config.yml 是统一配置源，可能含明文密钥（取代分散的 .env 与 models.yaml）
config.yml
config.yml.*
!config.yml.example

# 旧式模型配置文件（已被 config.yml 取代，保留忽略以防残留）
models.yaml
models.yaml.*
!models.yaml.example

# Skill install target
~/.skills/

tests/__pycache__/

# --- Runtime / scratch artifacts (never commit) ---
# 引擎与用户交互产生的运行时产物、工作日志、临时粘贴板、评估产物等，
# 含可能的真实执行记录与个人信息，必须忽略，防止 `git add -A` 误提交。
.workbuddy/
sessions/
pastes/
agent-eval/
plans/
*.log
*.ctx.json
run.log
run.log.ctx.json

# MCP 本地配置可能含绝对路径 / 用户名，仅入库模板
mcp.json
mcp.json.*
!mcp.json.example

# Skill 运行时产出的个人数据（面试报告、简历、状态、会话历史等）：
# 保留 skill 目录下的模板与脚本，但忽略各 skill 运行时生成的真实数据。
skills/*/reports/
skills/*/resume/
skills/*/state/
skills/*/session_history.json
